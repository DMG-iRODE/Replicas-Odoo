<script>
(function () {
    function ajustarFondosMes() {
        document.querySelectorAll(".irode-mes-section").forEach(function (section) {
            var grayDesktop = section.querySelector(".irode-mes-bg");
            var grayMobile = section.querySelector(".irode-mobile-gray");
            var whiteCut = section.querySelector(".irode-mobile-white-cut");
            var video = section.querySelector(".irode-mes-video-card");
            var callout = section.querySelector(".irode-callout-composition");

            if (!grayDesktop || !grayMobile || !whiteCut || !video || !callout) {
                return;
            }

            var sectionRect = section.getBoundingClientRect();
            var videoRect = video.getBoundingClientRect();
            var calloutRect = callout.getBoundingClientRect();

            if (window.innerWidth > 768) {
                grayMobile.style.top = "";
                grayMobile.style.height = "";
                whiteCut.style.top = "";
                whiteCut.style.height = "";

                var calloutCenter =
                    calloutRect.top - sectionRect.top + calloutRect.height / 2;

                grayDesktop.style.height =
                    Math.max(calloutCenter - 165, 0) + "px";
            } else {
                grayDesktop.style.height = "";

                var grayTop =
                    videoRect.top - sectionRect.top + videoRect.height * .28;

                var grayBottom =
                    calloutRect.top - sectionRect.top + calloutRect.height * .55;

                grayMobile.style.top = grayTop + "px";
                grayMobile.style.height =
                    Math.max(grayBottom - grayTop, 0) + "px";

                whiteCut.style.top = grayBottom + "px";
                whiteCut.style.height =
                    Math.max(0, section.scrollHeight - grayBottom) + "px";
            }
        });
    }

    function iniciarMes() {
        ajustarFondosMes();

        if ("ResizeObserver" in window) {
            var observer = new ResizeObserver(ajustarFondosMes);

            document.querySelectorAll(
                ".irode-mes-section .irode-mes-video-card, " +
                ".irode-mes-section .irode-callout-composition"
            ).forEach(function (element) {
                observer.observe(element);
            });
        }

        document.querySelectorAll(".irode-mes-section img").forEach(function (img) {
            img.addEventListener("load", ajustarFondosMes);
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", iniciarMes);
    } else {
        iniciarMes();
    }

    window.addEventListener("load", ajustarFondosMes);
    window.addEventListener("resize", ajustarFondosMes);
})();
</script>
