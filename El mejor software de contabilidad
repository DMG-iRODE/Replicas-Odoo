<script>
(function () {
    function iniciarAnimacionIrode() {
        document.querySelectorAll('.irode-funciones-section').forEach(function (section) {
            if (section.dataset.irodeAnimationInitialized === 'true') return;

            const cards = section.querySelectorAll('.irode-scroll-card');
            if (!cards.length) return;

            section.dataset.irodeAnimationInitialized = 'true';

            const reducirMovimiento = window.matchMedia &&
                window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (!('IntersectionObserver' in window) || reducirMovimiento) {
                cards.forEach(function (card) {
                    card.classList.add('irode-card-visible');
                });
                return;
            }

            /* Restablecer las tarjetas antes de iniciar la animación. */
            cards.forEach(function (card, index) {
                card.classList.remove(
                    'irode-card-visible',
                    'irode-card-pending',
                    'irode-card-animated'
                );
                card.style.transitionDelay = (index * 65) + 'ms';
            });

            section.classList.add('irode-animation-ready');

            /* Registrar el estado inicial antes de mostrar las tarjetas. */
            void section.offsetHeight;

            const observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        const card = entry.target;
                        card.classList.add('irode-card-visible');
                        observer.unobserve(card);

                        /* Evitar retrasos posteriores en el efecto hover. */
                        window.setTimeout(function () {
                            card.style.transitionDelay = '0ms';
                        }, 1000 + parseFloat(card.style.transitionDelay || '0'));
                    }
                });
            }, {
                threshold: 0.15,
                rootMargin: '0px 0px -25px 0px'
            });

            requestAnimationFrame(function () {
                cards.forEach(function (card) {
                    observer.observe(card);
                });
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', iniciarAnimacionIrode);
    } else {
        iniciarAnimacionIrode();
    }
})();
</script>
