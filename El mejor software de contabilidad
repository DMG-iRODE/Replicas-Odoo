<script>
(function () {
    function iniciarVideoIrode() {
        var modal = document.querySelector(".irode-pos-video-modal");
        if (!modal) return;

        var frame = modal.querySelector(".irode-pos-video-frame");
        var closeBtn = modal.querySelector(".irode-pos-video-close");
        var backdrop = modal.querySelector(".irode-pos-video-backdrop");
        var openers = document.querySelectorAll(
            ".irode-pos-showcase .irode-pos-video-open"
        );

        var consultaMovil = window.matchMedia("(max-width: 767px)");
        var videosMoviles = document.querySelectorAll(
            ".irode-pos-showcase .irode-pos-mobile-video"
        );

        var videoUrl =
            "https://www.youtube.com/embed/5S-1uDGD4GA?si=JWt69S4gkkHNU1ss";

        var videoMovilUrl =
            "https://www.youtube.com/embed/5S-1uDGD4GA?playsinline=1&rel=0";

        function openVideo() {
            frame.setAttribute("src", videoUrl);
            modal.classList.add("is-open");
            modal.setAttribute("aria-hidden", "false");
            document.body.classList.add("irode-video-modal-open");

            var dialog = modal.querySelector(".irode-pos-video-dialog");

            if (dialog) {
                dialog.scrollTop = 0;
            }
        }

        function closeVideo() {
            modal.classList.remove("is-open");
            modal.setAttribute("aria-hidden", "true");
            frame.setAttribute("src", "");
            document.body.classList.remove("irode-video-modal-open");
        }

        function actualizarVersion() {
            videosMoviles.forEach(function (video) {
                if (consultaMovil.matches) {
                    if (!video.getAttribute("src")) {
                        video.setAttribute("src", videoMovilUrl);
                    }
                } else {
                    /* Detener el video al pasar a computadora. */
                    video.removeAttribute("src");
                }
            });

            if (consultaMovil.matches) {
                closeVideo();
            }
        }

        openers.forEach(function (opener) {
            opener.addEventListener("click", openVideo);
        });

        closeBtn.addEventListener("click", closeVideo);
        backdrop.addEventListener("click", closeVideo);

        document.addEventListener("keydown", function (event) {
            if (
                event.key === "Escape" &&
                modal.classList.contains("is-open")
            ) {
                closeVideo();
