<script>

/* =========================================================
   FONDO GRIS ESCRITORIO
========================================================= */

function ajustarFondoMesEscritorio() {

    var section =
        document.querySelector(
            ".irode-mes-section"
        );


    var gray =
        document.querySelector(
            ".irode-mes-bg"
        );


    var callout =
        document.querySelector(
            ".irode-callout-composition"
        );


    if (
        !section ||
        !gray ||
        !callout
    ) {

        return;
    }


    if (
        window.innerWidth <= 768
    ) {

        gray.style.height = "";

        return;
    }


    var sectionRect =
        section.getBoundingClientRect();


    var calloutRect =
        callout.getBoundingClientRect();


    var grayTop = 165;


    var calloutCenter =
        (
            calloutRect.top -
            sectionRect.top
        )
        +
        (
            calloutRect.height / 2
        );


    var grayHeight =
        calloutCenter -
        grayTop;


    gray.style.height =
        Math.max(
            grayHeight,
            0
        ) + "px";

}


/* =========================================================
   FONDO GRIS MÓVIL
========================================================= */

function ajustarFondoMesMovil() {

    var section =
        document.querySelector(
            ".irode-mes-section"
        );


    var video =
        document.querySelector(
            ".irode-mes-video-card"
        );


    var callout =
        document.querySelector(
            ".irode-callout-composition"
        );


    var gray =
        document.querySelector(
            ".irode-mobile-gray"
        );


    var whiteCut =
        document.querySelector(
            ".irode-mobile-white-cut"
        );


    if (
        !section ||
        !video ||
        !callout ||
        !gray ||
        !whiteCut
    ) {

        return;
    }


    if (
        window.innerWidth > 768
    ) {

        gray.style.top = "";

        gray.style.height = "";

        whiteCut.style.top = "";

        whiteCut.style.height = "";

        return;
    }


    var sectionRect =
        section.getBoundingClientRect();


    var videoRect =
        video.getBoundingClientRect();


    var calloutRect =
        callout.getBoundingClientRect();


    /* Inicio del fondo gris */

    var grayTop =
        (
            videoRect.top -
            sectionRect.top
        )
        +
        (
            videoRect.height * 0.28
        );


    /* Final del gris */

    var grayBottom =
        (
            calloutRect.top -
            sectionRect.top
        )
        +
        (
            calloutRect.height * 0.55
        );


    var grayHeight =
        grayBottom -
        grayTop;


    gray.style.top =
        grayTop + "px";


    gray.style.height =
        Math.max(
            grayHeight,
            0
        ) + "px";


    whiteCut.style.top =
        grayBottom + "px";


    whiteCut.style.height =
        Math.max(
            0,
            section.scrollHeight -
            grayBottom
        ) + "px";

}


/* =========================================================
   CARGAR
========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        ajustarFondoMesMovil();

        ajustarFondoMesEscritorio();

    }
);


window.addEventListener(
    "load",
    function() {

        ajustarFondoMesMovil();

        ajustarFondoMesEscritorio();

    }
);


/* =========================================================
   RESIZE
========================================================= */

window.addEventListener(
    "resize",
    function() {

        ajustarFondoMesMovil();

        ajustarFondoMesEscritorio();

    }
);


/* =========================================================
   RESIZE OBSERVER
========================================================= */

if ("ResizeObserver" in window) {

    var observerMES =
        new ResizeObserver(
            function() {

                ajustarFondoMesMovil();

                ajustarFondoMesEscritorio();

            }
        );


    var videoMES =
        document.querySelector(
            ".irode-mes-video-card"
        );


    var calloutMES =
        document.querySelector(
            ".irode-callout-composition"
        );


    if (videoMES) {

        observerMES.observe(
            videoMES
        );
    }


    if (calloutMES) {

        observerMES.observe(
            calloutMES
        );
    }

}

