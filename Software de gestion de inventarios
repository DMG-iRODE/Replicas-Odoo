========================================================= */

window.addEventListener(
    "resize",
    function() {

        ajustarFondoMesMovil();
        ajustarFondoMesEscritorio();

    }
);



/* =========================================================
   SI CAMBIA EL TAMAÑO DE LOS ELEMENTOS
========================================================= */

if ("ResizeObserver" in window) {

    var observerMES =
        new ResizeObserver(
            function() {

                ajustarFondoMesMovil();
                ajustarFondoMesEscritorio();
        ajustarFondoMesEscritorio();

            }
        );


    var videoMES =
        document.querySelector(
