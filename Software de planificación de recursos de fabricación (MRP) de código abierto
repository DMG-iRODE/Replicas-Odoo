<script>

/* =========================================================
   AJUSTAR FONDO GRIS EN ESCRITORIO

   TERMINA EXACTAMENTE EN EL CENTRO
   DE "OBSERVA EL MES EN ACCIÓN"
   SIN MODIFICAR MÓVIL
========================================================= */

function ajustarFondoMesEscritorio() {

    var section =
        document.querySelector(
            ".irode-mes-section"
        );

    var gray =
        document.querySelector(
            ".irode-mes-bg"
        );

    var callout =
        document.querySelector(
            ".irode-mes-callout"
        );


    if (
        !section ||
        !gray ||
        !callout
    ) {
        return;
    }


    /* SOLO ESCRITORIO */

    if (window.innerWidth <= 768) {

        gray.style.height = "";

        return;
    }


    var sectionRect =
        section.getBoundingClientRect();

    var calloutRect =
        callout.getBoundingClientRect();


    /* MISMO INICIO DEL GRIS EN ESCRITORIO */

    var grayTop = 165;


    /* CENTRO EXACTO DE LA ÚLTIMA IMAGEN */

    var calloutCenter =
        (
            calloutRect.top -
            sectionRect.top
        )
        +
        (
            calloutRect.height / 2
        );


    var grayHeight =
        calloutCenter - grayTop;


    gray.style.height =
        Math.max(grayHeight, 0) + "px";

}



/* =========================================================
   CALCULAR FONDO GRIS EN MÓVIL

   1. COMIENZA DETRÁS DEL VIDEO
   2. TERMINA EXACTAMENTE EN EL CENTRO
      DE "OBSERVA EL MES EN ACCIÓN"
========================================================= */

function ajustarFondoMesMovil() {

    var section =
        document.querySelector(
            ".irode-mes-section"
        );

    var video =
        document.querySelector(
            ".irode-mes-video-card"
        );

    var callout =
        document.querySelector(
            ".irode-mes-callout"
        );

    var gray =
        document.querySelector(
            ".irode-mobile-gray"
        );

    var whiteCut =
        document.querySelector(
            ".irode-mobile-white-cut"
        );


    if (
        !section ||
        !video ||
        !callout ||
        !gray ||
        !whiteCut
    ) {
        return;
    }


    /*
       SOLO MÓVIL
    */

    if (window.innerWidth > 768) {

        gray.style.top = "";
        gray.style.height = "";

        whiteCut.style.top = "";
        whiteCut.style.height = "";

        return;
    }


    var sectionRect =
        section.getBoundingClientRect();

    var videoRect =
        video.getBoundingClientRect();

    var calloutRect =
        callout.getBoundingClientRect();


    /*
       -----------------------------------------------------
       INICIO DEL GRIS

       LO PONEMOS APROXIMADAMENTE
       A 28% DE LA ALTURA DEL VIDEO.

       ASÍ LA CURVA QUEDA BIEN ARRIBA,
       DETRÁS DE LA PORTADA.
       -----------------------------------------------------
    */

    var grayTop =
        (
            videoRect.top -
            sectionRect.top
        )
        +
        (
            videoRect.height * 0.28
        );


    /*
       -----------------------------------------------------
       FINAL DEL GRIS

       EXACTAMENTE EN EL CENTRO
       VERTICAL DE LA ÚLTIMA IMAGEN.
       -----------------------------------------------------
    */

    var grayBottom =
        (
            calloutRect.top -
            sectionRect.top
        )
        +
        (
            calloutRect.height / 2
        );


    /*
       ALTURA TOTAL DEL GRIS
    */

    var grayHeight =
        grayBottom - grayTop;


    gray.style.top =
        grayTop + "px";


    gray.style.height =
        grayHeight + "px";


    /*
       DESDE EL CENTRO EXACTO DE LA IMAGEN HACIA ABAJO
       TODO QUEDA BLANCO.
    */

    whiteCut.style.top =
        grayBottom + "px";

    whiteCut.style.height =
        Math.max(0, section.scrollHeight - grayBottom) + "px";

}



/* =========================================================
   EJECUTAR CUANDO CARGUE
========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        ajustarFondoMesMovil();
        ajustarFondoMesEscritorio();

    }
);



/* =========================================================
   EJECUTAR CUANDO TERMINEN DE CARGAR LAS IMÁGENES
========================================================= */

window.addEventListener(
    "load",
    function() {

        ajustarFondoMesMovil();
        ajustarFondoMesEscritorio();

    }
);



/* =========================================================
   RECALCULAR AL CAMBIAR TAMAÑO
========================================================= */

window.addEventListener(
    "resize",
    function() {

        ajustarFondoMesMovil();
        ajustarFondoMesEscritorio();

    }
);



/* =========================================================
   SI CAMBIA EL TAMAÑO DE LOS ELEMENTOS
========================================================= */

if ("ResizeObserver" in window) {

    var observerMES =
        new ResizeObserver(
            function() {

                ajustarFondoMesMovil();
                ajustarFondoMesEscritorio();
        ajustarFondoMesEscritorio();

            }
        );


    var videoMES =
