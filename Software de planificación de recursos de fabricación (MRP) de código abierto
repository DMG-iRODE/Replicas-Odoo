<script>

(function () {

    const cards =
        document.querySelectorAll(
            '.irode-scroll-card'
        );


    if (!cards.length) {
        return;
    }


    if (!('IntersectionObserver' in window)) {

        cards.forEach(function (card) {

            card.classList.add(
                'irode-visible'
            );

        });

        return;
    }


    const observer =
        new IntersectionObserver(

            function (entries) {

                entries.forEach(
                    function (entry) {

                        if (entry.isIntersecting) {

                            entry.target.classList.add(
                                'irode-visible'
                            );

                            observer.unobserve(
                                entry.target
                            );

                        }

                    }
                );

            },

            {
                threshold:
                    0.15,

                rootMargin:
                    '0px 0px -25px 0px'
            }

        );


    cards.forEach(
        function (card, index) {

            card.style.transitionDelay =
                (index * 65) + 'ms';

            observer.observe(
                card
            );

        }
    );

})();

</script>
